---
import BaseLayout from "../layouts/BaseLayout.astro";

const publics = [
  {
    title: "Adolescents et adultes",
    copy:
      "Pour les personnes qui traversent une période de fragilité, de tension intérieure, de questionnement ou de rupture dans leur équilibre."
  },
  {
    title: "Anxiété, trauma, phobies",
    copy:
      "Quand l’alerte prend trop de place : troubles anxieux, peurs envahissantes, stress post-traumatique ou souvenirs difficiles."
  },
  {
    title: "Corps, douleurs, psychosomatique",
    copy:
      "Lorsque le corps devient le lieu d’expression d’un conflit, d’une douleur chronique, d’une fatigue ou d’un rapport compliqué à soi."
  },
  {
    title: "Transitions et liens",
    copy:
      "Deuil, séparation, maladie, changement de vie, épuisement professionnel, difficultés familiales ou relationnelles."
  }
];

const competences = [
  "Psychologie clinique et psychothérapie",
  "Hypnothérapie et rêve éveillé phénoméno-existentiel",
  "Psychotraumatologie",
  "Accompagnement des adolescents et adultes",
  "Coordination de parcours pluridisciplinaires",
  "Supervision de psychologues cliniciens"
];

const formations = [
  "Diplôme de psychologue clinicienne, École des Psychologues Praticiens",
  "D.U. de psychotraumatologie, Université Paris Descartes",
  "Formation en hypnothérapie, Institut Français d’Hypnose",
  "Formation en rêve éveillé phénoméno-existentiel, IREPHE",
  "Expériences en cabinet, centre spécialisé, association et suivi pluridisciplinaire"
];

const seances = [
  {
    step: "01",
    title: "Premier échange",
    copy:
      "Un temps pour comprendre votre demande, votre contexte et ce que vous attendez d’un accompagnement."
  },
  {
    step: "02",
    title: "Cadre ajusté",
    copy:
      "La fréquence, le rythme et les objectifs se définissent ensemble, selon votre situation et votre disponibilité psychique."
  },
  {
    step: "03",
    title: "Travail thérapeutique",
    copy:
      "Les séances soutiennent la parole, les ressentis, les ressources et la mise en mouvement progressive."
  }
];
---

<BaseLayout
  title="Aude Réhault | Psychologue clinicienne"
  description="Aude Réhault, psychologue clinicienne à Nantes, Clisson et en visio. Psychothérapie, hypnothérapie, psychotraumatologie, anxiété, douleurs chroniques et accompagnement adolescents-adultes."
>
  <section class="hero section-boundary" id="accueil">
    <div class="hero-copy reveal">
      <p class="section-kicker">Aude Réhault · Psychologue clinicienne</p>
      <h1>Un espace pour traverser, comprendre et retrouver de l’appui.</h1>
      <p class="hero-text">
        Psychologue clinicienne, psychothérapeute et hypnothérapeute, Aude Réhault accompagne
        les adolescents et les adultes confrontés à des difficultés psychiques, corporelles,
        relationnelles ou existentielles.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#contact">Prendre rendez-vous</a>
        <a class="button button-secondary" href="#publics">À qui ça s’adresse</a>
      </div>
      <div class="hero-tags" aria-label="Principaux champs d'accompagnement">
        <span>Anxiété</span>
        <span>Psychotrauma</span>
        <span>Douleurs chroniques</span>
        <span>Hypnose</span>
      </div>
    </div>

    <div class="hero-visual reveal" aria-label="Aquarelle abstraite en tons kaki, bleu et lumière diffuse">
      <div class="hero-image"></div>
      <div class="hero-plate">
        <span>Cabinets</span>
        <strong>Nantes · Clisson · Visio</strong>
      </div>
    </div>
  </section>

  <section class="intro-strip reveal" aria-label="Repère principal">
    <p>
      Une approche humaniste et phénoméno-existentielle : accueillir la personne dans sa singularité,
      sans la réduire à un symptôme.
    </p>
  </section>

  <section class="section section-boundary publics-section" id="publics">
    <div class="section-heading reveal">
      <p class="section-kicker">À qui ça s’adresse</p>
      <h2>Pour les personnes qui cherchent un lieu stable où déposer ce qui déborde.</h2>
      <p>
        Les demandes peuvent concerner l’anxiété, le psychotraumatisme, les phobies, les douleurs
        chroniques, le rapport au corps, les conduites addictives, les difficultés personnelles ou
        professionnelles, ainsi que les périodes de transition.
      </p>
    </div>

    <div class="public-grid">
      {publics.map((item) => (
        <article class="public-card reveal">
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="image-band section-boundary reveal" id="approche" aria-label="Approche thérapeutique">
    <div class="image-band-copy">
      <p class="section-kicker">Approche</p>
      <h2>Une écoute clinique, sensible au corps, à l’histoire et aux ressources.</h2>
      <p>
        Le travail thérapeutique s’appuie sur la parole, l’hypnose, l’attention aux éprouvés et la
        construction progressive de repères. Il peut accompagner des moments de crise comme un
        cheminement plus long.
      </p>
    </div>
    <div class="image-band-visual"></div>
  </section>

  <section class="section section-boundary practitioner-section" id="praticienne">
    <div class="section-heading reveal">
      <p class="section-kicker">Qui est la praticienne</p>
      <h2>Aude Réhault, psychologue clinicienne et hypnothérapeute.</h2>
      <p>
        Son parcours associe cabinet libéral, coordination d’équipes pluridisciplinaires, supervision
        clinique et engagement associatif. Elle a notamment cofondé La Note Bleue et participé au
        développement de SOS Anor Grand Ouest à Nantes.
      </p>
    </div>

    <div class="practitioner-layout">
      <div class="practitioner-visual reveal"></div>
      <div class="practitioner-copy reveal">
        <article>
          <h3>Compétences</h3>
          <ul class="check-list">
            {competences.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article>
          <h3>Formations et expériences</h3>
          <ul class="check-list">
            {formations.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-boundary seances-section" id="seances">
    <div class="section-heading reveal">
      <p class="section-kicker">Séances</p>
      <h2>Un cadre clair, sobre et ajusté à votre rythme.</h2>
      <p>
        La durée de l’accompagnement dépend de la demande, de la situation et de ce qui se construit
        au fil des séances. Le premier rendez-vous sert à poser les bases du travail.
      </p>
    </div>

    <div class="session-grid">
      {seances.map((seance) => (
        <article class="session-card reveal">
          <span>{seance.step}</span>
          <h3>{seance.title}</h3>
          <p>{seance.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="contact-band section-boundary reveal" id="contact">
    <div class="contact-copy">
      <p class="section-kicker">Contact</p>
      <h2>Prendre rendez-vous</h2>
      <p>
        Les consultations se déroulent en cabinet à Nantes ou Clisson, avec possibilité de rendez-vous
        en visio selon les situations. La prise de rendez-vous se fait en ligne.
      </p>
    </div>
    <address class="contact-card">
      <div>
        <span>Nantes</span>
        <p>7 rue des Rochettes, 44000 Nantes</p>
      </div>
      <div>
        <span>Clisson</span>
        <p>Cabinet libéral à Clisson</p>
      </div>
      <div>
        <span>Rendez-vous</span>
        <a href="https://www.doctolib.fr/psychologue/nantes/aude-rehault" target="_blank" rel="noopener noreferrer">
          Voir les disponibilités
        </a>
      </div>
    </address>
  </section>

</BaseLayout>
