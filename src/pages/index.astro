---
import BaseLayout from "../layouts/BaseLayout.astro";

const motifs = [
  {
    title: "Anxiété et surcharge",
    copy:
      "Quand le mental reste en alerte, que le sommeil se fragilise ou que le quotidien demande trop d’effort."
  },
  {
    title: "Transitions de vie",
    copy:
      "Séparation, deuil, changement professionnel, maternité, nouvelle étape ou besoin de retrouver un cap."
  },
  {
    title: "Estime de soi",
    copy:
      "Mettre des mots sur les blocages, les répétitions relationnelles et les conflits intérieurs qui prennent de la place."
  },
  {
    title: "Épuisement",
    copy:
      "Retrouver de l’appui après une période de fatigue morale, de burn-out ou de perte d’élan."
  }
];

const seances = [
  {
    step: "01",
    title: "Premier échange",
    copy:
      "Un temps pour comprendre votre demande, votre contexte et ce que vous attendez d’un accompagnement."
  },
  {
    step: "02",
    title: "Cadre clair",
    copy:
      "La fréquence, le rythme et les objectifs se définissent ensemble, avec une attention particulière à votre sécurité."
  },
  {
    step: "03",
    title: "Travail en profondeur",
    copy:
      "Les séances soutiennent la parole, les ressentis, les ressources et la mise en mouvement progressive."
  }
];

const reperes = [
  "Accueil des adultes, jeunes adultes et adolescents.",
  "Consultations en cabinet à Nantes et possibilité de rendez-vous en visio.",
  "Accompagnement ponctuel ou suivi plus régulier selon la situation."
];
---

<BaseLayout
  title="Aude Rehault | Psychologue clinicienne"
  description="Aude Rehault, psychologue clinicienne à Nantes et en visio. Consultations pour anxiété, transitions de vie, épuisement et perte de repères."
>
  <section class="hero" id="accueil">
    <div class="hero-copy">
      <p class="section-kicker">Aude Rehault · Psychologue clinicienne</p>
      <h1>Un espace pour retrouver appui, clarté et souffle.</h1>
      <p class="hero-text">
        J’accompagne les personnes qui traversent une période de tension, de doute ou de
        transformation. Le travail thérapeutique offre un lieu calme pour déposer ce qui pèse,
        comprendre ce qui se répète et remettre du mouvement là où tout semble figé.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#contact">Prendre rendez-vous</a>
        <a class="button button-secondary" href="#approche">Découvrir l’approche</a>
      </div>
      <ul class="hero-notes" aria-label="Repères pratiques">
        {reperes.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="hero-visual" aria-label="Ambiance calme du cabinet">
      <div class="hero-image"></div>
      <div class="hero-plate">
        <span>Consultations</span>
        <strong>Nantes · Visio</strong>
      </div>
    </div>
  </section>

  <section class="intro-strip" aria-label="Repère principal">
    <p>
      Une présence attentive, un cadre stable, et une approche qui respecte le rythme de chaque
      personne.
    </p>
  </section>

  <section class="section approach-section" id="approche">
    <div class="section-heading">
      <p class="section-kicker">Approche</p>
      <h2>Écouter ce qui se vit, pas seulement ce qui se dit.</h2>
      <p>
        La consultation est pensée comme un espace de parole et de soutien psychique. On y travaille
        à partir de votre histoire, de vos sensations, de vos liens et des questions qui cherchent à
        prendre forme.
      </p>
    </div>

    <div class="approach-grid">
      <article class="principle-card">
        <span>01</span>
        <h3>Un cadre fiable</h3>
        <p>
          La régularité, la confidentialité et la qualité de présence créent un lieu où il devient
          possible d’explorer sans se sentir pressé.
        </p>
      </article>
      <article class="principle-card">
        <span>02</span>
        <h3>Une parole vivante</h3>
        <p>
          Les mots aident à relier les événements, les émotions et les choix du quotidien, pour
          sortir peu à peu de la confusion.
        </p>
      </article>
      <article class="principle-card">
        <span>03</span>
        <h3>Des ressources concrètes</h3>
        <p>
          Selon les besoins, le travail peut aussi soutenir l’ancrage, la respiration, la confiance
          et la capacité à poser des limites.
        </p>
      </article>
    </div>
  </section>

  <section class="image-band" aria-label="Ambiance intérieure du cabinet">
    <div class="image-band-copy">
      <p class="section-kicker">Cadre thérapeutique</p>
      <h2>Un espace simple, calme et suffisamment souple.</h2>
      <p>
        L’accompagnement peut être bref ou s’inscrire dans la durée. L’essentiel est de construire
        un rythme qui aide vraiment, sans ajouter une contrainte de plus.
      </p>
    </div>
    <div class="image-band-visual"></div>
  </section>

  <section class="section motifs-section" id="motifs">
    <div class="section-heading">
      <p class="section-kicker">Motifs</p>
      <h2>Quand consulter ?</h2>
      <p>
        Il n’est pas nécessaire d’attendre que tout déborde pour demander de l’aide. Une consultation
        peut simplement commencer par le sentiment que quelque chose a besoin d’être entendu.
      </p>
    </div>

    <div class="motif-list">
      {motifs.map((motif) => (
        <article class="motif-row">
          <h3>{motif.title}</h3>
          <p>{motif.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section seances-section" id="seances">
    <div class="section-heading">
      <p class="section-kicker">Séances</p>
      <h2>Un déroulement lisible, ajusté à votre rythme.</h2>
      <p>
        Les séances permettent de clarifier ce qui vous amène, puis d’avancer pas à pas vers une
        meilleure compréhension de vous-même et de vos possibilités d’action.
      </p>
    </div>

    <div class="session-grid">
      {seances.map((seance) => (
        <article class="session-card">
          <span>{seance.step}</span>
          <h3>{seance.title}</h3>
          <p>{seance.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="parcours-band" id="parcours">
    <div class="parcours-visual"></div>
    <div class="parcours-copy">
      <p class="section-kicker">Parcours</p>
      <h2>Une pratique clinique ancrée dans l’écoute et l’accompagnement.</h2>
      <p>
        La formation de psychologue clinicienne soutient une attention particulière à la singularité
        de chaque personne. Le parcours, les lectures et la pratique nourrissent une manière de
        travailler sobre, engagée et respectueuse.
      </p>
      <p>
        Le point de départ reste toujours votre demande : ce qui vous arrive, ce qui insiste, ce que
        vous souhaitez comprendre ou transformer.
      </p>
    </div>
  </section>

  <section class="contact-band" id="contact">
    <div class="contact-copy">
      <p class="section-kicker">Contact</p>
      <h2>Prendre rendez-vous</h2>
      <p>
        Pour un premier échange ou une demande de suivi, vous pouvez me contacter par téléphone ou
        par email. Les consultations ont lieu sur rendez-vous, en cabinet à Nantes ou en visio.
      </p>
    </div>
    <address class="contact-card">
      <div>
        <span>Téléphone</span>
        <a href="tel:+33600000000">06 00 00 00 00</a>
      </div>
      <div>
        <span>Email</span>
        <a href="mailto:contact@aude-rehault.fr">contact@aude-rehault.fr</a>
      </div>
      <div>
        <span>Lieu</span>
        <p>Nantes et consultations en visio</p>
      </div>
    </address>
  </section>
</BaseLayout>
