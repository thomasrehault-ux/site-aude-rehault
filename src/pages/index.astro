---
import "../styles/aude-v2.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const asset = (path: string) => `${base}${path}`;
const canonicalUrl = new URL(`${base}/`, Astro.site ?? "https://thomasrehault-ux.github.io").toString();
const socialImageUrl = new URL(`${base}/og.png`, Astro.site ?? "https://thomasrehault-ux.github.io").toString();

const accompagnements = [
  {
    number: "01",
    tone: "blue",
    title: "Troubles des conduites alimentaires (TCA)",
    copy: "Anorexie, boulimie, hyperphagie"
  },
  {
    number: "02",
    tone: "green",
    title: "Corps, douleurs & trauma",
    copy: "Troubles psychotraumatiques, douleurs chroniques, psychosomatique, anxiété, stress"
  },
  {
    number: "03",
    tone: "sky",
    title: "Traversées existentielles",
    copy: "Changements de vie, péri-natalité, deuil, séparation, crises existentielles…"
  }
];

const infos = [
  { symbol: "◷", label: "Durée d’une séance", value: "Environ 50 minutes" },
  { symbol: "€", label: "Tarif", value: "80 €" },
  { symbol: "⌂", label: "Consultations", value: "Nantes et Clisson" },
  { symbol: "↗", label: "Rendez-vous", value: "En ligne sur Doctolib" }
];

const competences = [
  "Psychologie clinique et psychothérapie",
  "Hypnothérapie et rêve éveillé phénoméno-existentiel",
  "Psychotraumatologie",
  "Troubles des conduites alimentaires (TCA)",
  "Accompagnement des adolescents et adultes",
  "Coordination de parcours pluridisciplinaires",
  "Supervision de psychologues cliniciens",
  "Écriture et publications cliniques"
];

const formations = [
  "Diplôme de psychologue clinicienne, École des Psychologues Praticiens",
  "D.U. de psychotraumatologie, Université Paris Descartes",
  "Formation en hypnothérapie, Institut Français d’Hypnose",
  "Formation en rêve éveillé phénoméno-existentiel, IREPHE",
  "Expériences en cabinet, centre spécialisé, association et suivi pluridisciplinaire"
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Aude Réhault, psychologue clinicienne, psychothérapeute et hypnothérapeute à Nantes et Clisson. Accompagnement des adolescents et des adultes."
    />
    <meta name="theme-color" content="#ebf1fa" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content="Aude Réhault · Psychologue clinicienne" />
    <meta property="og:description" content="Psychologue clinicienne, psychothérapeute et hypnothérapeute à Nantes et Clisson." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="Aude Réhault, psychologue clinicienne — un espace pour écouter, comprendre et avancer." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Aude Réhault · Psychologue clinicienne" />
    <meta name="twitter:description" content="Psychologue clinicienne, psychothérapeute et hypnothérapeute à Nantes et Clisson." />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>Aude Réhault · Psychologue clinicienne</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="header" data-header>
      <a class="brand" href="#accueil" aria-label="Aude Réhault, revenir à l’accueil">
        <img
          class="brand-avatar"
          src={asset("/assets/aude-rehault-portrait.jpg")}
          alt=""
          width="239"
          height="315"
          aria-hidden="true"
        />
        <span class="brand-copy">
          <strong>Aude Réhault</strong>
          <small>Psychologue clinicienne</small>
        </span>
      </a>

      <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-navigation">
        <span></span><span></span><span></span>
        <span class="sr-only">Ouvrir le menu</span>
      </button>

      <nav class="navigation" id="main-navigation" aria-label="Navigation principale">
        <a href="#accueil">Accueil</a>
        <a href="#accompagnements">Accompagnements</a>
        <a href="#approche">Ma pratique</a>
        <a href="#parcours">Mon parcours</a>
        <a href="#publications">Publications</a>
        <a href="#informations">Infos pratiques</a>
      </nav>

      <a class="button button-header" href="https://www.doctolib.fr/psychologue/nantes/aude-rehault" target="_blank" rel="noopener noreferrer">
        Prendre rendez-vous
      </a>
    </header>

    <main>
      <section class="hero" id="accueil">
        <div class="hero-copy">
          <h1>
            Psychologue Clinicienne <span class="hero-separator">–</span>
            Psychothérapeute <span class="hero-separator">–</span> Hypnothérapeute
          </h1>
          <div class="hero-actions">
            <a class="button button-primary" href="https://www.doctolib.fr/psychologue/nantes/aude-rehault" target="_blank" rel="noopener noreferrer">
              Prendre rendez-vous
            </a>
            <a class="text-link" href="#approche">Découvrir ma pratique <span>→</span></a>
          </div>
          <dl class="hero-details">
            <div><dt>Public</dt><dd>Adolescents & adultes</dd></div>
            <div><dt>Lieu de consultation</dt><dd>Nantes et Clisson</dd></div>
          </dl>
        </div>

        <div
          class="hero-visual"
          style={`--hero-backdrop: url("${asset("/assets/approach-soulages-blue-v1.png")}")`}
          aria-hidden="true"
        ></div>
      </section>

      <section class="accompaniments section" id="accompagnements">
        <div class="section-heading section-heading-simple">
          <p class="eyebrow"><span>01</span> Accompagnements</p>
        </div>

        <div class="card-grid">
          {accompagnements.map((item) => (
            <article class:list={["support-card", `support-card-${item.tone}`]}>
              <span class="card-number">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="approach section" id="approche">
        <div class="approach-visual">
          <img
            src={asset("/assets/hero-soulages-blue-v1.png")}
            alt="Composition abstraite aux gestes brossés dans des tons bleu clair et bleu profond"
            width="1536"
            height="1024"
            loading="lazy"
          />
            <span class="approach-stamp">
              <strong>Écouter, expérimenter, comprendre, ouvrir, mettre en mouvement</strong>
            </span>
        </div>
        <div class="approach-copy">
          <p class="eyebrow"><span>02</span> Ma pratique</p>
          <ul class="practice-list">
            <li>Humaniste</li>
            <li>Phénoméno-existentielle</li>
            <li>Individuelle</li>
            <li>Hypnose et états modifiés de conscience</li>
            <li>Psycho-corporelle</li>
            <li>Prise en compte de toutes les dimensions de l’être</li>
          </ul>
        </div>
      </section>

      <section class="practitioner section" id="parcours">
        <div class="practitioner-intro">
          <div class="practitioner-title">
            <p class="eyebrow"><span>03</span> Mon parcours</p>
            <h2>Une formation clinique nourrie par l’expérience du terrain.</h2>
          </div>
          <div class="practitioner-summary">
            <p>
              Mon parcours associe cabinet libéral, coordination d’équipes pluridisciplinaires,
              formation, supervision clinique, engagement associatif et travail d’écriture. J’ai
              notamment cofondé l’association La Note Bleue et SOS Anor à Paris, puis créé le
              cabinet La Note Bleue à Nantes. Je suis également auteure d’ouvrages et d’articles
              consacrés à la clinique, à l’hypnose et aux troubles des conduites alimentaires.
            </p>
          </div>
        </div>

        <div class="career-grid">
          <article class="career-card career-card-blue">
            <p class="career-label">Compétences</p>
            <h3>Une pratique clinique, intégrative et pluridisciplinaire.</h3>
            <ol class="career-list">
              {competences.map((competence) => (
                <li><p>{competence}</p></li>
              ))}
            </ol>
            <a class="text-link career-publication-link" href="#publications">
              Découvrir mes publications <span>→</span>
            </a>
          </article>

          <article class="career-card career-card-green">
            <p class="career-label">Formations et expériences</p>
            <h3>Un parcours nourri par des cadres et des outils variés.</h3>
            <ol class="career-list">
              {formations.map((formation) => (
                <li><p>{formation}</p></li>
              ))}
            </ol>
          </article>
        </div>

        <div class="publications" id="publications" aria-labelledby="publications-title">
          <div class="publications-heading">
            <p class="eyebrow">Écriture & transmission</p>
            <h2 id="publications-title">Publications et médias</h2>
          </div>

          <div class="publications-grid">
            <article class="publication-card publication-book">
              <a
                class="publication-cover publication-cover-primary"
                href="https://www.amazon.fr/Sortir-lanorexie-boulimie-trajectoire-daccompagnement-ebook/dp/B0BZZ8FTBR?ref_=ast_author_mpb"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Voir le livre Sortir de l’anorexie et de la boulimie sur Amazon"
              >
                <img
                  src={asset("/assets/sortir-anorexie-boulimie.png")}
                  alt="Couverture du livre Sortir de l’anorexie et de la boulimie d’Aude Réhault"
                  width="1194"
                  height="1500"
                  loading="lazy"
                />
              </a>
              <div class="publication-copy">
                <p class="publication-type">Livre</p>
                <h3>Sortir de l’anorexie et de la boulimie</h3>
                <p>Construire sa trajectoire de soin</p>
                <a
                  class="text-link"
                  href="https://www.amazon.fr/Sortir-lanorexie-boulimie-trajectoire-daccompagnement-ebook/dp/B0BZZ8FTBR?ref_=ast_author_mpb"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Découvrir le livre <span>→</span>
                </a>
              </div>
            </article>

            <article class="publication-card publication-article">
              <a
                class="publication-cover publication-cover-review"
                href="https://doi.org/10.3917/jhsi.019.0040"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Lire l’article Troubles du comportement alimentaire d’Aude Réhault sur Cairn.info"
              >
                <img
                  src={asset("/assets/revue-hypnose-sante-19.png")}
                  alt="Couverture du numéro 19 de La Revue de l’hypnose et de la santé"
                  width="355"
                  height="508"
                  loading="lazy"
                />
              </a>
              <div class="publication-copy">
                <p class="publication-type">Article</p>
                <h3>Troubles du comportement alimentaire</h3>
                <p>Par Aude Réhault · pages 40–47.</p>
                <a
                  class="text-link"
                  href="https://doi.org/10.3917/jhsi.019.0040"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Lire sur Cairn.info <span>→</span>
                </a>
              </div>
            </article>

            <article class="publication-card publication-collective-book">
              <a
                class="publication-cover publication-cover-collective"
                href="https://www.dunod.com/sciences-humaines-et-sociales/psychotherapies-adultes-victimes-d-inceste-ou-violences-sexuelles-dans"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Voir l’ouvrage Psychothérapies des adultes victimes d’inceste ou de violences sexuelles dans l’enfance chez Dunod"
              >
                <img
                  src={asset("/assets/psychotherapies-adultes-victimes-inceste.png")}
                  alt="Couverture du livre Psychothérapies des adultes victimes d’inceste ou de violences sexuelles dans l’enfance"
                  width="403"
                  height="508"
                  loading="lazy"
                />
              </a>
              <div class="publication-copy">
                <p class="publication-type">Ouvrage collectif</p>
                <h3>Psychothérapies des adultes victimes d’inceste ou de violences sexuelles dans l’enfance</h3>
                <p>Contribution d’Aude Réhault à l’ouvrage collectif dirigé par Joanna Smith.</p>
                <a
                  class="text-link"
                  href="https://www.dunod.com/sciences-humaines-et-sociales/psychotherapies-adultes-victimes-d-inceste-ou-violences-sexuelles-dans"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Découvrir chez Dunod <span>→</span>
                </a>
              </div>
            </article>

            <article class="publication-card publication-video">
              <div class="video-frame">
                <iframe
                  src="https://www.youtube-nocookie.com/embed/PsuEGGgvP1s"
                  title="Interview vidéo d’Aude Réhault"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                ></iframe>
              </div>
              <div class="publication-copy">
                <p class="publication-type">Interview vidéo</p>
                <h3>Écouter Aude Réhault</h3>
                <p>Un échange autour de sa pratique et de son travail d’accompagnement.</p>
                <a
                  class="text-link"
                  href="https://www.youtube.com/watch?v=PsuEGGgvP1s"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Voir sur YouTube <span>→</span>
                </a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="practical section" id="informations" aria-labelledby="practical-title">
        <div class="practical-heading">
          <p class="eyebrow"><span>04</span> Informations pratiques</p>
          <h2 id="practical-title">Tout ce qu’il faut savoir.</h2>
        </div>
        <div class="info-grid">
          {infos.map((info) => (
            <article>
              <span class="info-symbol" aria-hidden="true">{info.symbol}</span>
              <h3>{info.label}</h3>
              <p>{info.value}</p>
            </article>
          ))}
        </div>
        <figure class="cabinet-visual">
          <img
            src={asset("/assets/cabinet-aude.jpg")}
            alt="Le cabinet de consultation d’Aude Réhault"
            width="2200"
            height="942"
            loading="lazy"
          />
        </figure>
      </section>
    </main>

    <footer class="footer">
      <a class="brand footer-brand" href="#accueil">
        <img
          class="brand-avatar"
          src={asset("/assets/aude-rehault-portrait.jpg")}
          alt=""
          width="239"
          height="315"
          aria-hidden="true"
        />
        <span class="brand-copy"><strong>Aude Réhault</strong><small>Psychologue clinicienne</small></span>
      </a>
      <div>
        <h2>Navigation</h2>
        <a href="#accompagnements">Accompagnements</a>
        <a href="#approche">Ma pratique</a>
        <a href="#parcours">Mon parcours</a>
        <a href="#publications">Publications</a>
        <a href="#informations">Infos pratiques</a>
      </div>
      <div>
        <h2>Cabinets</h2>
        <p>Nantes · Clisson</p>
      </div>
      <div>
        <h2>Informations</h2>
        <p>Mentions légales</p>
        <p>Politique de confidentialité</p>
      </div>
      <p class="footer-bottom">© {new Date().getFullYear()} Aude Réhault · Tous droits réservés</p>
    </footer>

    <script is:inline>
      const menuButton = document.querySelector(".menu-button");
      const navigation = document.querySelector(".navigation");

      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!isOpen));
        navigation?.classList.toggle("is-open", !isOpen);
      });

      navigation?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menuButton?.setAttribute("aria-expanded", "false");
          navigation.classList.remove("is-open");
        });
      });
    </script>
  </body>
</html>
