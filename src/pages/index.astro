---
import "../styles/aude-v2.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const asset = (path: string) => `${base}${path}`;
const canonicalUrl = new URL(`${base}/`, Astro.site ?? "https://thomasrehault-ux.github.io").toString();
const socialImageUrl = new URL(`${base}/og.png`, Astro.site ?? "https://thomasrehault-ux.github.io").toString();

const accompagnements = [
  {
    number: "01",
    tone: "blue",
    title: "Anxiété, stress & phobies",
    copy: "Apaiser l’alerte intérieure, mieux comprendre ce qui l’active et retrouver un sentiment de sécurité."
  },
  {
    number: "02",
    tone: "green",
    title: "Corps, douleurs & trauma",
    copy: "Accueillir ce que le corps exprime, traverser les vécus traumatiques et renouer avec ses ressources."
  },
  {
    number: "03",
    tone: "sky",
    title: "Transitions & relations",
    copy: "Être accompagné lors d’un deuil, d’une séparation, d’un changement de vie ou de difficultés relationnelles."
  }
];

const etapes = [
  {
    number: "1",
    title: "Premier échange",
    copy: "Nous faisons connaissance et prenons le temps de clarifier votre demande, votre contexte et vos besoins."
  },
  {
    number: "2",
    title: "Un cadre ajusté",
    copy: "Le rythme, la fréquence et les objectifs se définissent ensemble, dans un cadre clair et sécurisant."
  },
  {
    number: "3",
    title: "Le cheminement",
    copy: "La parole, l’hypnose et l’attention au corps soutiennent un mouvement progressif, à votre rythme."
  }
];

const infos = [
  { symbol: "◷", label: "Durée d’une séance", value: "Environ 50 minutes" },
  { symbol: "€", label: "Tarif", value: "À préciser ensemble" },
  { symbol: "⌂", label: "Consultations", value: "7 rue des Rochettes, Nantes · Clisson · Visio" },
  { symbol: "↗", label: "Rendez-vous", value: "En ligne sur Doctolib" }
];

const competences = [
  "Psychologie clinique et psychothérapie",
  "Hypnothérapie et rêve éveillé phénoméno-existentiel",
  "Psychotraumatologie",
  "Accompagnement des adolescents et adultes",
  "Coordination de parcours pluridisciplinaires",
  "Supervision de psychologues cliniciens"
];

const formations = [
  "Diplôme de psychologue clinicienne, École des Psychologues Praticiens",
  "D.U. de psychotraumatologie, Université Paris Descartes",
  "Formation en hypnothérapie, Institut Français d’Hypnose",
  "Formation en rêve éveillé phénoméno-existentiel, IREPHE",
  "Expériences en cabinet, centre spécialisé, association et suivi pluridisciplinaire"
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Aude Réhault, psychologue clinicienne et hypnothérapeute à Nantes, Clisson et en visio. Accompagnement des adolescents et des adultes."
    />
    <meta name="theme-color" content="#ebf1fa" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content="Aude Réhault · Psychologue clinicienne" />
    <meta property="og:description" content="Un espace pour écouter, comprendre et avancer." />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="Aude Réhault, psychologue clinicienne — un espace pour écouter, comprendre et avancer." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Aude Réhault · Psychologue clinicienne" />
    <meta name="twitter:description" content="Un espace pour écouter, comprendre et avancer." />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>Aude Réhault · Psychologue clinicienne</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="header" data-header>
      <a class="brand" href="#accueil" aria-label="Aude Réhault, revenir à l’accueil">
        <img
          class="brand-avatar"
          src={asset("/assets/aude-rehault-portrait.jpg")}
          alt=""
          width="239"
          height="315"
          aria-hidden="true"
        />
        <span class="brand-copy">
          <strong>Aude Réhault</strong>
          <small>Psychologue clinicienne</small>
        </span>
      </a>

      <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-navigation">
        <span></span><span></span><span></span>
        <span class="sr-only">Ouvrir le menu</span>
      </button>

      <nav class="navigation" id="main-navigation" aria-label="Navigation principale">
        <a href="#accueil">Accueil</a>
        <a href="#approche">Mon approche</a>
        <a href="#accompagnements">Accompagnements</a>
        <a href="#parcours">Mon parcours</a>
        <a href="#seances">Infos pratiques</a>
        <a href="#contact">Contact</a>
      </nav>

      <a class="button button-header" href="https://www.doctolib.fr/psychologue/nantes/aude-rehault" target="_blank" rel="noopener noreferrer">
        Prendre rendez-vous
      </a>
    </header>

    <main>
      <section class="hero" id="accueil">
        <div class="hero-copy">
          <p class="eyebrow">Psychologue clinicienne · Nantes, Clisson & visio</p>
          <h1>Un espace pour vous écouter, comprendre et <em>avancer.</em></h1>
          <p class="hero-intro">
            Psychologue clinicienne, psychothérapeute et hypnothérapeute, j’accompagne les
            adolescents et les adultes lorsque l’équilibre se fragilise, dans un cadre attentif,
            sécurisant et ajusté à chacun.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="https://www.doctolib.fr/psychologue/nantes/aude-rehault" target="_blank" rel="noopener noreferrer">
              Prendre rendez-vous
            </a>
            <a class="text-link" href="#approche">Découvrir mon approche <span>→</span></a>
          </div>
          <dl class="hero-details">
            <div><dt>Public</dt><dd>Adolescents & adultes</dd></div>
            <div><dt>Modalités</dt><dd>Cabinet & téléconsultation</dd></div>
          </dl>
        </div>

        <div
          class="hero-visual"
          style={`--hero-backdrop: url("${asset("/assets/hero-soulages-blue-v1.png")}")`}
          aria-hidden="true"
        ></div>
      </section>

      <section class="accompaniments section" id="accompagnements">
        <div class="section-heading">
          <p class="eyebrow"><span>01</span> Vous accompagner</p>
          <h2>Des accompagnements adaptés à chaque étape de votre cheminement.</h2>
          <p>
            Anxiété, phobies, psychotrauma, douleurs chroniques, conduites addictives,
            difficultés personnelles ou professionnelles&nbsp;: chaque demande est singulière.
          </p>
        </div>

        <div class="card-grid">
          {accompagnements.map((item) => (
            <article class:list={["support-card", `support-card-${item.tone}`]}>
              <span class="card-number">{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
              <a href="#contact">En parler ensemble <span>→</span></a>
            </article>
          ))}
        </div>
      </section>

      <section class="approach section" id="approche">
        <div class="approach-visual">
          <img
            src={asset("/assets/approach-art-generated.png")}
            alt="Paysage abstrait à l’aquarelle dans des tons bleu clair"
            width="1536"
            height="1024"
            loading="lazy"
          />
            <span class="approach-stamp">
              <small>Trois repères</small>
              <strong>Écouter · relier · mettre en mouvement</strong>
            </span>
        </div>
        <div class="approach-copy">
          <p class="eyebrow"><span>02</span> Mon approche</p>
          <h2>Une approche intégrative, humaine et sur mesure.</h2>
          <p>
            Chaque personne est unique. Mon rôle est de vous offrir un espace sécurisant et
            bienveillant, où vous pouvez déposer ce que vous traversez et avancer à votre rythme.
          </p>
          <p>
            J’intègre différentes approches thérapeutiques : psychologie clinique, hypnose,
            psychotraumatologie et rêve éveillé phénoméno-existentiel.
          </p>
          <a class="text-link" href="#contact">En savoir plus sur mon approche <span>→</span></a>
        </div>
      </section>

      <section class="practitioner section" id="parcours">
        <div class="practitioner-intro">
          <div class="practitioner-title">
            <p class="eyebrow"><span>03</span> Qui suis-je ?</p>
            <h2>Une formation clinique nourrie par l’expérience du terrain.</h2>
          </div>
          <div class="practitioner-summary">
            <p>
              Mon parcours associe cabinet libéral, coordination d’équipes pluridisciplinaires,
              supervision clinique et engagement associatif. J’ai notamment cofondé La Note Bleue
              et participé au développement de SOS Anor Grand Ouest à Nantes.
            </p>
          </div>
        </div>

        <div class="career-grid">
          <article class="career-card career-card-blue">
            <p class="career-label">Compétences</p>
            <h3>Une pratique clinique, intégrative et pluridisciplinaire.</h3>
            <ol class="career-list">
              {competences.map((competence) => (
                <li><p>{competence}</p></li>
              ))}
            </ol>
          </article>

          <article class="career-card career-card-green">
            <p class="career-label">Formations et expériences</p>
            <h3>Un parcours nourri par des cadres et des outils variés.</h3>
            <ol class="career-list">
              {formations.map((formation) => (
                <li><p>{formation}</p></li>
              ))}
            </ol>
          </article>
        </div>
      </section>

      <section class="sessions section" id="seances">
        <div class="section-heading section-heading-wide">
          <p class="eyebrow"><span>04</span> Comment se déroule une séance ?</p>
          <h2>Un cadre simple, clair et sécurisant.</h2>
        </div>

        <ol class="steps">
          {etapes.map((etape) => (
            <li>
              <span class="step-number">{etape.number}</span>
              <h3>{etape.title}</h3>
              <p>{etape.copy}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="practical section" aria-labelledby="practical-title">
        <div class="practical-heading">
          <p class="eyebrow"><span>05</span> Informations pratiques</p>
          <h2 id="practical-title">Tout ce qu’il faut savoir.</h2>
        </div>
        <div class="info-grid">
          {infos.map((info) => (
            <article>
              <span class="info-symbol" aria-hidden="true">{info.symbol}</span>
              <h3>{info.label}</h3>
              <p>{info.value}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="contact section" id="contact">
        <div class="contact-copy">
          <p class="eyebrow"><span>06</span> Contact</p>
          <h2>Vous vous demandez si cet accompagnement peut vous convenir&nbsp;?</h2>
          <p>N’hésitez pas à me contacter pour un premier échange.</p>
          <div class="contact-actions">
            <a class="button button-green" href="https://www.doctolib.fr/psychologue/nantes/aude-rehault" target="_blank" rel="noopener noreferrer">
              Prendre rendez-vous
            </a>
            <a class="text-link" href="https://www.doctolib.fr/psychologue/nantes/aude-rehault" target="_blank" rel="noopener noreferrer">
              Voir les disponibilités <span>→</span>
            </a>
          </div>
        </div>
        <figure class="contact-visual">
          <img
            src={asset("/assets/cabinet-aude.jpg")}
            alt="Le cabinet de consultation d’Aude Réhault"
            width="2200"
            height="942"
            loading="lazy"
          />
        </figure>
      </section>
    </main>

    <footer class="footer">
      <a class="brand footer-brand" href="#accueil">
        <img
          class="brand-avatar"
          src={asset("/assets/aude-rehault-portrait.jpg")}
          alt=""
          width="239"
          height="315"
          aria-hidden="true"
        />
        <span class="brand-copy"><strong>Aude Réhault</strong><small>Psychologue clinicienne</small></span>
      </a>
      <div>
        <h2>Navigation</h2>
        <a href="#approche">Mon approche</a>
        <a href="#accompagnements">Accompagnements</a>
        <a href="#parcours">Mon parcours</a>
        <a href="#seances">Infos pratiques</a>
      </div>
      <div>
        <h2>Cabinets</h2>
        <p>Nantes · Clisson</p>
        <p>Consultations en visio</p>
      </div>
      <div>
        <h2>Informations</h2>
        <a href="#contact">Contact</a>
        <p>Mentions légales</p>
        <p>Politique de confidentialité</p>
      </div>
      <p class="footer-bottom">© {new Date().getFullYear()} Aude Réhault · Tous droits réservés</p>
    </footer>

    <script is:inline>
      const menuButton = document.querySelector(".menu-button");
      const navigation = document.querySelector(".navigation");

      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!isOpen));
        navigation?.classList.toggle("is-open", !isOpen);
      });

      navigation?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          menuButton?.setAttribute("aria-expanded", "false");
          navigation.classList.remove("is-open");
        });
      });
    </script>
  </body>
</html>
